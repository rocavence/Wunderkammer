    "允許 AI 助手把連結、文字和檔案收進來，或加進釘選版。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow assistants to collect links, text, and files, or put things on pinned boards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que el asistente guarde enlaces, texto y archivos, o los añada a tableros fijados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI アシスタントがリンク、テキスト、ファイルを収集したり、ピン留めボードに加えたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 어시스턴트가 링크, 텍스트, 파일을 담거나 고정 보드에 추가할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o assistente guarde links, texto e arquivos, ou os coloque em quadros fixados."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 AI 助手把連結、文字和檔案收進來，或加進釘選版。"
          }
        }
      }
    },
    "允許後再按一次 ⌘⇧C，就能收藏這個瀏覽器的網址" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After allowing access, press ⌘⇧C again to collect this browser's URL"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
