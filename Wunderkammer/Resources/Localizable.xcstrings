    "「%@」收進來的檔案，都會複製一份到這個資料夾，用原本的檔名存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files added to “%@” are copied to this folder under their original names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que se añadan a “%@” se copiarán a esta carpeta con su nombre original."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に追加したファイルは、元のファイル名のままこのフォルダにコピーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에 수집한 파일은 모두 원래 파일 이름 그대로 이 폴더에 복사됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos adicionados a “%@” serão copiados para esta pasta, com o nome original."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」收進來的檔案，都會複製一份到這個資料夾，用原本的檔名存。"
          }
        }
      }
    },
    "一般": {
