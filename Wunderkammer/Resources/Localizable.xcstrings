          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐비닛: %@, 항목 %lld개. 클릭하여 전환하거나 관리"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gabinete: %@, %lld itens. Clique para alternar ou gerenciar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "珍奇櫃：%@，%lld 件收藏。按一下切換或管理"
          }
        }
      }
    },
