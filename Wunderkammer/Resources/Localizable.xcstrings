    "Ask a question about what you've collected. Answered on this Mac by Apple Intelligence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question about what you've collected. Answered on this Mac by Apple Intelligence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta sobre lo que has guardado. Apple Intelligence responde en este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集めたものについて質問します。このMac上で Apple Intelligence が回答します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수집한 항목에 대해 질문하십시오. 이 Mac에서 Apple Intelligence가 답변합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta sobre o que você coletou. A resposta é gerada neste Mac pela Apple Intelligence."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question about what you've collected. Answered on this Mac by Apple Intelligence."
          }
        }
      }
    },
