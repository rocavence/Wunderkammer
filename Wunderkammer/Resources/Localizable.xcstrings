    "只放標題、網站與主題，不放文字內容": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only titles, sites and themes, no text content"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo títulos, sitios y temas, sin el texto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル、サイト、テーマのみを含め、本文は含めません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목, 사이트, 테마만 포함하며 텍스트 내용은 포함하지 않음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente título, site e temas, sem o conteúdo do texto"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只放標題、網站與主題，不放文字內容"
          }
        }
      }
    },
    "只用在選中與作用中的東西：所在的空間、選取、拖放的目標。可以跟隨系統，或用取自圖示拱門的顏色。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只用在選中與作用中的東西：所在的空間、選取、拖放的目標。可以跟隨系統，或用取自圖示拱門的顏色。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only for selected and active things: the current space, selections and drop targets. Follow the system, or use a color taken from the arch in the icon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中・作業中のものだけに使われます：今いるスペース、選択、ドロップ先。システムに合わせるか、アイコンのアーチから取った色を選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택되거나 활성화된 것에만 쓰입니다: 현재 공간, 선택 항목, 놓을 위치. 시스템을 따르거나 아이콘의 아치에서 가져온 색을 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa en lo seleccionado y activo: el espacio actual, las selecciones y los destinos al soltar. Sigue al sistema o usa un color tomado del arco del icono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada só no que está selecionado e ativo: o espaço atual, as seleções e os destinos ao soltar. Siga o sistema ou use uma cor tirada do arco do ícone."
          }
        }
      }
    },
