    "收進來就好，不必整理。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just collect it. No need to organize."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo guárdalo, sin organizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加するだけ。整理は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수집만 하면 됩니다. 정리할 필요 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É só coletar, sem organizar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收進來就好，不必整理。"
