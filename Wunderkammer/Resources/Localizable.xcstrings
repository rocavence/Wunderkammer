        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 찾을 수 없음\n다른 단어나 색상, 연도, 사이트 이름으로 시도해 보십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada encontrado para “%@”\nTente outras palavras, ou uma cor, ano ou nome de site"
