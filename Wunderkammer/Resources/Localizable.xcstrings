    "收藏還不夠多，系統還看不出關聯\n收得越多，主題、名字與網站之間的線就會慢慢長出來": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough items yet to see connections\nThe more you collect, the more lines grow between themes, names and sites"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes elementos para ver relaciones\nCuanto más guardes, más líneas irán surgiendo entre temas, nombres y sitios"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイテムがまだ少なく、関連が見えてきません\n集めるほど、テーマ、名前、サイトのあいだに線が少しずつ伸びていきます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 항목이 많지 않아 관계를 파악할 수 없습니다\n더 많이 수집할수록 테마, 이름, 사이트 사이의 연결선이 조금씩 늘어납니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há itens suficientes para ver relações\nQuanto mais você coleta, mais surgem linhas entre temas, nomes e sites"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏還不夠多，系統還看不出關聯\n收得越多，主題、名字與網站之間的線就會慢慢長出來"
          }
        }
      }
    },
